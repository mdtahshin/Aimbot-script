-- ESP labels + scaling
RunService.RenderStepped:Connect(function()
	if not state.ESP then return end
	local myRoot = getRoot(player.Character)
	if not myRoot then return end

	for _, other in ipairs(Players:GetPlayers()) do
		if isEnemy(other) and other.Character then
			local bb = other.Character:FindFirstChild("ESP_Tag")
			local root = getRoot(other.Character)
			local hum = getHum(other.Character)
			if bb and root then
				local dist = (camera.CFrame.Position - root.Position).Magnitude
				local scale = math.clamp(220 / dist, 0.4, 1.7)
				bb.Size = UDim2.new(0, 90 * scale, 0, 130 * scale)
				bb.StudsOffset = Vector3.new(0, 3.2, 0)

				local dLbl = bb:FindFirstChild("Dist")
				if dLbl then dLbl.Text = string.format("%dm", math.floor(dist)) end

				local hpBg = bb:FindFirstChild("HpBg")
				if hpBg and hum then
					local fill = hpBg:FindFirstChild("Fill")
					if fill then
						local r = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
						fill.Size = UDim2.new(r, 0, 1, 0)
						fill.BackgroundColor3 = Color3.fromRGB(
							math.floor(255 * (1 - r)),
							math.floor(255 * r),
							70
						)
					end
				end
			end
		end
	end
end)

-- Tracers
RunService.RenderStepped:Connect(function()
	if not state.TRACERS then
		if #tracerFolder:GetChildren() > 0 then clearTracers() end
		return
	end
	if not state.ESP then
		if #tracerFolder:GetChildren() > 0 then clearTracers() end
		return
	end

	local origin = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y + 50)

	for _, other in ipairs(Players:GetPlayers()) do
		if isEnemy(other) and other.Character then
			local root = getRoot(other.Character)
			local hum  = getHum(other.Character)
			if root and hum and hum.Health > 0 then
				local sp, onScreen = camera:WorldToViewportPoint(root.Position)
				local tracer = getTracer(other)
				if onScreen and sp.Z > 0 then
					local target = Vector2.new(sp.X, sp.Y)
					local delta = target - origin
					local length = delta.Magnitude
					local angle = math.deg(math.atan2(delta.Y, delta.X)) - 90

					tracer.Visible = true
					tracer.Position = UDim2.new(0, origin.X, 0, origin.Y)
					tracer.Size = UDim2.new(0, 1.5, 0, length)
					tracer.Rotation = angle
					tracer.BackgroundTransparency = 0.35
				else
					tracer.Visible = false
				end
			end
		end
	end
end)

-- Target indicator + auto-update target
RunService.RenderStepped:Connect(function()
	if not state.AIMBOT then
		indicator.Visible = false
		return
	end

	local aimPos, root = getBestTarget()
	currentTarget = root

	if root and aimPos then
		local sp, onScreen = camera:WorldToViewportPoint(aimPos)
		if onScreen and sp.Z > 0 then
			indicator.Visible = true
			indicator.Position = UDim2.new(0, sp.X, 0, sp.Y)
		else
			indicator.Visible = false
		end
	else
		indicator.Visible = false
	end
end)

--=============================================================
--  INPUT  (PC + Mobile)
--=============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		silentFire()
	end
end)

local function hookTool(tool)
	tool.Activated:Connect(function() silentFire() end)
end

local function hookChar(char)
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
end

--=============================================================
--  CHARACTER / PLAYER HOOKS
--=============================================================
local function onChar(char)
	task.wait(0.25)
	if state.SPEED then setSpeed(true) end
	if state.ESP then applyESP(char) end
	hookChar(char)
end

if player.Character then onChar(player.Character) end
player.CharacterAdded:Connect(onChar)

local function watchPlayer(other)
	if other == player then return end
	if other.Character then applyESP(other.Character) end
	other.CharacterAdded:Connect(function(c)
		task.wait(0.25)
		applyESP(c)
	end)
	other.CharacterRemoving:Connect(function(c)
		removeESP(c)
		local t = tracerFolder:FindFirstChild(other.Name)
		if t then t:Destroy() end
	end)
end

for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function(p)
	if p.Character then removeESP(p.Character) end
	local t = tracerFolder:FindFirstChild(p.Name)
	if t then t:Destroy() end
end)
