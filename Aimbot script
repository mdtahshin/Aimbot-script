	local h = getHum(player.Character)
	if h then h.WalkSpeed = on and SPEED_VALUE or NORMAL_SPEED end
end

--=============================================================
--  LOOPS
--=============================================================

-- ESP distance scaling + labels
RunService.RenderStepped:Connect(function()
	if not state.ESP then return end
	local myRoot = getRoot(player.Character)
	if not myRoot then return end

	for _, other in ipairs(Players:GetPlayers()) do
		if isEnemy(other) and other.Character then
			local bb   = other.Character:FindFirstChild("ESP_Tag")
			local root = getRoot(other.Character)
			local hum  = getHum(other.Character)
			if bb and root then
				local dist = (camera.CFrame.Position - root.Position).Magnitude

				-- Distance-based scaling
				local scale = math.clamp(220 / dist, 0.35, 1.6)
				bb.Size = UDim2.new(0, 80 * scale, 0, 110 * scale)

				local dLbl = bb:FindFirstChild("Dist")
				if dLbl then dLbl.Text = string.format("%dm", math.floor(dist)) end

				local hpBg = bb:FindFirstChild("HpBg")
				if hpBg and hum then
					local fill = hpBg:FindFirstChild("Fill")
					if fill then
						local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
						fill.Size = UDim2.new(ratio, 0, 1, 0)
						fill.BackgroundColor3 = Color3.fromRGB(
							math.floor(255 * (1 - ratio)),
							math.floor(255 * ratio),
							80
						)
					end
				end
			end
		end
	end
end)

-- Auto-acquire target (used only for highlighting awareness; does not move camera)
RunService.RenderStepped:Connect(function()
	if state.AIMBOT then
		currentTarget = getBestTarget()
	else
		currentTarget = nil
	end
end)

--=============================================================
--  INPUT  (PC + Mobile)
--=============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		silentFire()
	end
end)

-- Backup: hook tool activation (fires on both PC and mobile)
local function hookTool(tool)
	tool.Activated:Connect(function()
		silentFire()
	end)
end

local function hookChar(char)
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
end

--=============================================================
--  PLAYER / CHARACTER HOOKS
--=============================================================
local function onChar(char)
	task.wait(0.2)
	if state.SPEED then setSpeed(true) end
	if state.ESP then applyESP(char) end
	hookChar(char)
end

if player.Character then onChar(player.Character) end
player.CharacterAdded:Connect(onChar)

local function watchPlayer(other)
	if other == player then return end
	if other.Character then applyESP(other.Character) end
	other.CharacterAdded:Connect(function(c)
		task.wait(0.2)
		applyESP(c)
	end)
	other.CharacterRemoving:Connect(function(c)
		removeESP(c)
	end)
end

for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function(p)
	if p.Character then removeESP(p.Character) end
end)

