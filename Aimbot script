-- Toggle factory
local function makeToggle(name, order, getter, setter)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.85, 0, 0, 40)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
	btn.TextColor3 = Color3.fromRGB(220, 220, 220)
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 15
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	btn.Parent = panel
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local function refresh()
		local on = getter()
		btn.Text = name .. (on and "  ▶  ON" or "  ▶  OFF")
		btn.BackgroundColor3 = on and Color3.fromRGB(45, 150, 90) or Color3.fromRGB(40, 40, 55)
		btn.TextColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
	end

	btn.MouseButton1Click:Connect(function()
		setter(not getter())
		refresh()
	end)
	refresh()
	return btn
end

