	label.Size = UDim2.new(0.55, 0, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = "◉  FOV: " .. state.FOV_RADIUS
	label.TextColor3 = Color3.fromRGB(220, 220, 235)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local function mkBtn(txt, x, delta)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 30, 0, 26)
		b.Position = UDim2.new(x, 0, 0.5, -13)
		b.BackgroundColor3 = Color3.fromRGB(55, 55, 85)
		b.TextColor3 = Color3.fromRGB(255, 255, 255)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 15
		b.Text = txt
		b.AutoButtonColor = false
		b.Parent = row
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

		b.MouseEnter:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(80, 80, 130)}):Play()
		end)
		b.MouseLeave:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 85)}):Play()
		end)

		b.MouseButton1Click:Connect(function()
			state.FOV_RADIUS = math.clamp(state.FOV_RADIUS + delta, CONFIG.MIN_FOV, CONFIG.MAX_FOV)
			label.Text = "◉  FOV: " .. state.FOV_RADIUS
			TweenService:Create(fovCircle, TweenInfo.new(0.2), {
				Size = UDim2.new(0, state.FOV_RADIUS * 2, 0, state.FOV_RADIUS * 2)
			}):Play()
		end)
		return b
	end

	mkBtn("−", 0.58, -CONFIG.FOV_STEP)
	mkBtn("+", 0.80,  CONFIG.FOV_STEP)
	return row
end

