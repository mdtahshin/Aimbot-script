--=============================================================
--  AIMBOT (silent aim)
--=============================================================
local currentTarget = nil

local function isVisible(targetRoot)
	if not CONFIG.VISIBLE_ONLY then return true end
	local origin = camera.CFrame.Position
	local dir = targetRoot.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(origin, dir, params)
	if result and result.Instance then
		return result.Instance:IsDescendantOf(targetRoot.Parent)
	end
	return true
end

local function predictPosition(root, hum)
	local velocity = root.AssemblyLinearVelocity
	local distance = (root.Position - camera.CFrame.Position).Magnitude
	local travel = distance / 500 -- rough bullet-speed assumption (studs per sec)
	return root.Position + velocity * travel
end

local function getBestTarget()
	local myRoot = getRoot(player.Character)
	if not myRoot then return nil end

	local best, bestScore, bestRoot = nil, math.huge, nil
	local center = camera.ViewportSize / 2

	for _, other in ipairs(Players:GetPlayers()) do
		if isEnemy(other) then
			local root = getRoot(other.Character)
			local hum  = getHum(other.Character)
			if root and hum and hum.Health > 0 then
				local dist = (myRoot.Position - root.Position).Magnitude
				if dist <= CONFIG.MAX_RANGE then
					local aimPos = CONFIG.PREDICTION and predictPosition(root, hum) or root.Position
					local screenPos, onScreen = camera:WorldToViewportPoint(aimPos)
					if onScreen and screenPos.Z > 0 then
						local offset = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						if offset <= state.FOV_RADIUS and offset < bestScore and isVisible(root) then
							best, bestScore, bestRoot = aimPos, offset, root
						end
					end
				end
			end
		end
	end
	return best, bestRoot
end

local function silentFire()
	if not state.AIMBOT then return end
	local aimPos = getBestTarget()
	if not aimPos then return end

	local saved = camera.CFrame
	camera.CFrame = CFrame.new(saved.Position, aimPos)

	local done = false
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if done then return end
		done = true
		camera.CFrame = saved
		conn:Disconnect()
	end)
end

