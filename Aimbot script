function removeESP(character)
	for _, c in ipairs(character:GetChildren()) do
		if c.Name == "ESP_Highlight" or c.Name == "ESP_Tag" then
			c:Destroy()
		end
	end
end

function applyESP(character)
	if not state.ESP then return end
	local plr = Players:GetPlayerFromCharacter(character)
	if not isEnemy(plr) then return end
	if not character:FindFirstChild("ESP_Tag") then
		createESP(character)
	end
end

--=============================================================
--  AIMBOT  (silent aim — camera is NOT locked)
--=============================================================
local function isVisible(targetRoot)
	if not VISIBLE_ONLY then return true end
	local origin = camera.CFrame.Position
	local dir = targetRoot.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(origin, dir, params)
	if result and result.Instance then
		return result.Instance:IsDescendantOf(targetRoot.Parent)
	end
	return true
end

local currentTarget = nil

local function getBestTarget()
	local myRoot = getRoot(player.Character)
	if not myRoot then return nil end

	local best, bestScore = nil, math.huge
	local center = camera.ViewportSize / 2

	for _, other in ipairs(Players:GetPlayers()) do
		if isEnemy(other) then
			local root = getRoot(other.Character)
			local hum  = getHum(other.Character)
			if root and hum and hum.Health > 0 then
				local dist = (myRoot.Position - root.Position).Magnitude
				if dist <= MAX_RANGE then
					local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
					if onScreen and screenPos.Z > 0 then
						local offset = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						if offset <= state.FOV_RADIUS and offset < bestScore and isVisible(root) then
							best, bestScore = root, offset
						end
					end
				end
			end
		end
	end
	return best
end

-- Silent-aim: briefly point camera at target for 1 frame so the shot registers on them,
-- then restore the player's real view. Camera never visibly locks.
local function silentFire()
	if not state.AIMBOT then return end
	local target = getBestTarget()
	if not target then return end

	local saved = camera.CFrame
	camera.CFrame = CFrame.new(saved.Position, target.Position)

	local restored = false
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if restored then return end
		restored = true
		camera.CFrame = saved
		conn:Disconnect()
	end)
end

